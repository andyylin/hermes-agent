+    scoped_multiplex["MATRIX_ALLOWED_USERS"] = "@profile:example.org"
+
+    assert _discord_env("DISCORD_ALLOWED_CHANNELS") == "profile-channel"
+    assert _matrix_env("MATRIX_ALLOWED_USERS") == "@profile:example.org"
